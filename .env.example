# ---------------------------------------------------------------------------
# Purple Skills — variáveis de ambiente
#
# Todo segredo aceita duas formas: `<NOME>` (valor direto) ou `<NOME>_FILE`
# (caminho de um arquivo com o valor). Quando `<NOME>_FILE` está definido, ele
# tem prioridade — é o padrão recomendado com Docker/Kubernetes secrets.
#
# Os limites numéricos abaixo são validados no boot: um valor com sufixo
# (`25MB`, `30s`) ou não numérico derruba o serviço com uma mensagem explícita,
# em vez de virar "sem limite" silenciosamente. Deixar vazio usa o padrão.
#
# `CHANGE_ME` é placeholder, não valor: ele é público neste repositório, e as
# credenciais que autenticam alguém — ADMIN_PASSWORD, ADMIN_SESSION_SECRET e
# MCP_ADMIN_TOKEN — são RECUSADAS no boot enquanto estiverem assim. Gere cada
# uma com `openssl rand -hex 32`.
# ---------------------------------------------------------------------------

# Banco de dados (imagem pgvector/pgvector:pg18-trixie)
POSTGRES_USER=postgres
# Obrigatória: o compose recusa subir sem ela. Qualquer caractere serve, com
# uma exceção: `$` precisa ser escrito `$$` (a interpolação do compose o consome).
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=purple_skills
# Usada pelos serviços rodando FORA do compose (dev local, migrations no host).
# Dentro do compose a conexão vai por PGHOST/PGUSER/PGPASSWORD/PGDATABASE, que
# dispensam escape. Aqui, por ser uma URL, a senha PRECISA ser percent-encodada:
# `/` → %2F, `?` → %3F, `#` → %23, `%` → %25. Alternativa: exportar as PG* acima.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/purple_skills
# Conexões simultâneas no pool de CADA aplicação (padrão: 10). Não é ajuste do
# servidor: quem a lê é o pacote @purple-skills/db, em todos os cinco apps —
# os timeouts de conexão e de ociosidade estão em database/README.md.
DB_POOL_MAX=

# Site do catálogo
SITE_BASE_URL=http://localhost:3000
SITE_NAME=Purple Skills
SITE_TAGLINE=Skills abertas para agentes de IA
# Endereços mostrados na seção "Endereços de acesso" do site. Cada um que
# ficar vazio some da página — nada é adivinhado a partir do Host.
# MCP_PUBLIC_URL é a BASE, sem `/mcp`: o site acrescenta o sufixo ao mostrar o
# endereço do MCP público. Ela também é a base dos MCPs virtuais
# (docs/08-mcp-virtual.md): o painel a usa no snippet de conexão
# (<MCP_PUBLIC_URL>/virtual/<slug>/mcp) e o mcp-public nas URLs de download que
# as ferramentas devolvem.
MCP_PUBLIC_URL=
MCP_ADMIN_URL=
ADMIN_URL=
# Origens aceitas na API pública do site (padrão: `*`, qualquer origem — a API
# é alternativa ao MCP e foi feita para ser consumida). Uma instalação
# alcançável só pela rede interna deve fechar aqui, com uma origem ou uma lista
# separada por vírgula: com `*` a rede deixa de proteger, porque um site externo
# aberto por quem trabalha lá lê o catálogo usando o navegador da vítima.
SITE_CORS_ORIGIN=
# Requisições por minuto por IP no site (padrão: 240; `0` desliga, para quem já
# limita no proxy). Generoso de propósito — quem navega é pessoa, muitas vezes
# atrás de um NAT com o escritório inteiro. /healthz e /assets/ ficam fora da
# conta; sobram as rotas /api/*, os arquivos de skill e os downloads.
SITE_RATE_LIMIT_MAX=

# Admin (web) — a senha de BOOTSTRAP.
# Ela não é mais a senha do painel: serve para criar o PRIMEIRO administrador
# em /setup e, a partir daí, fica inerte — o acesso passa a ser por conta
# (e-mail + senha). Ver docs/05-accounts-and-roles.md §2.3.
# Continua obrigatória numa instalação nova, e pode ser removida depois que
# existir ao menos uma conta (desde que ADMIN_SESSION_SECRET esteja definido).
ADMIN_PASSWORD=CHANGE_ME
# ADMIN_PASSWORD_FILE=/run/secrets/admin_password
# Recomendado definir explicitamente: `openssl rand -hex 32`.
# Se omitido, é derivado da senha com scrypt (trocar a senha invalida as
# sessões). A derivação é lenta de propósito: o cookie de sessão é assinado com
# este segredo, e um cookie capturado permitiria testar senhas offline.
# Este é o segredo que assina o cookie do painel: deixá-lo em CHANGE_ME deixaria
# qualquer pessoa fabricar uma sessão de administrador. O boot recusa.
ADMIN_SESSION_SECRET=CHANGE_ME
# ADMIN_SESSION_SECRET_FILE=/run/secrets/admin_session_secret
# Duração da sessão do painel, em segundos (padrão: 12h)
ADMIN_SESSION_TTL=43200
# Tamanho máximo de upload no painel, em bytes (padrão: 64 MB)
ADMIN_MAX_UPLOAD_BYTES=67108864
# Links externos da sidebar do painel (docs/10-admin-canvas-e-sessoes.md).
# Cada um que ficar vazio some do menu; a documentação aponta para o GitHub
# do projeto por padrão.
ADMIN_DOCS_URL=
ADMIN_SUPPORT_URL=
ADMIN_CHAT_URL=
# Marca do painel: o nome e o ícone no topo da sidebar, no login e na aba do
# navegador. Vazio, o nome acompanha SITE_NAME; o ícone aceita URL http(s) ou
# caminho do próprio painel (padrão: /assets/images/purple-hat-256.png).
# Um ícone inválido derruba o boot.
ADMIN_BRAND_NAME=
ADMIN_BRAND_ICON_URL=

# MCP administrativo — token obrigatório.
# Continua valendo como credencial de máquina (papel `admin`, ator
# `token-global` na auditoria). Cada usuário pode emitir chaves próprias
# `psk_…` no painel, que carregam o papel e o nome do dono.
MCP_ADMIN_TOKEN=CHANGE_ME
# MCP_ADMIN_TOKEN_FILE=/run/secrets/mcp_admin_token
# Nome deste servidor no handshake (padrão: `purple-skills-admin`). Há uma
# variável por serviço de propósito: um valor único para os dois deixaria dois
# servidores com o mesmo nome no mcp.json de quem conecta.
MCP_ADMIN_SERVER_NAME=

# MCP público (/mcp) — não há mais configuração de acesso aqui
# (docs/09-mcp-padrao-e-skills-flutuantes.md). O que responde em /mcp é o MCP
# virtual escolhido como padrão em Configurações, no painel, e quem decide o
# acesso é ele: aberto, ou chaves psv_ emitidas na página dele. Sem MCP padrão,
# /mcp responde 404. As variáveis antigas MCP_PUBLIC_AUTH e MCP_PUBLIC_KEY
# derrubam o boot do mcp-public se ainda estiverem definidas — remova-as depois
# de ajustar o MCP padrão no painel.
#
# Nome deste servidor no handshake (padrão: `purple-skills`); ver o par
# MCP_ADMIN_SERVER_NAME acima.
MCP_PUBLIC_SERVER_NAME=

# ---------------------------------------------------------------------------
# Imagens e limites de container (lidos pelo docker-compose, não pelos apps)
# ---------------------------------------------------------------------------
# Tag das imagens do Docker Hub que o compose usa (padrão: latest). Fixá-la numa
# versão é o que torna o deploy repetível.
# TAG=latest
# Versão que os dois MCPs anunciam no handshake e que o painel mostra em
# Configurações. Vazia, os MCPs anunciam o valor compilado na imagem — hoje
# congelado em 1.0.0-beta.1 — e o painel não mostra nada. Preencha com o mesmo
# valor de TAG: é a resposta de "qual versão você está rodando?".
APP_VERSION=
# Teto de memória de cada container de aplicação (site, painel, os dois MCPs e
# o indexer) e da homepage, que tem o seu. Os padrões são 1536m e 256m, e o
# `memswap_limit` acompanha o teto, de propósito. O de 1,5 GB é dimensionado
# pelo pior import legítimo: o .zip recebido, os bytes descomprimidos
# (ZIP_MAX_UNCOMPRESSED_BYTES) e a segunda cópia deles. Aumentou aquele teto?
# Suba este na mesma conta (~2 × o teto descomprimido + 200 MB).
# APP_MEM_LIMIT=1536m
# HOMEPAGE_MEM_LIMIT=256m

# Teto de memória dos containers do banco, que moram em
# database/docker-compose.yml: 2048m no postgres e 512m nos passos migrate e
# seed (`memswap_limit` acompanha os dois, e nenhum tem teto de CPU). O do banco
# é dimensionado pelo que o kernel NÃO consegue recuperar quando o cgroup enche:
# as áreas compartilhadas (shared_buffers 128 MB, o padrão do PG 18), os 50
# backends que o pool dos apps abre (DB_POOL_MAX × 5 serviços) com o work_mem de
# cada sort/hash, e três autovacuum a maintenance_work_mem. Subiu algum desses?
# Suba o teto na mesma conta: apertado demais ele deixa o OOM killer derrubar o
# postmaster, e aí o limite é a causa da queda, não a proteção.
# POSTGRES_MEM_LIMIT=2048m
# DB_JOB_MEM_LIMIT=512m

# Endereço em que o docker-compose publica as portas abaixo.
# 127.0.0.1 (padrão) = só a própria máquina. Use 0.0.0.0 apenas quando quiser
# mesmo alcançar os serviços de outra máquina — lembrando que o Docker escreve
# iptables por conta própria e um bind em 0.0.0.0 contorna o UFW.
# O mcp-inspector NÃO acompanha esta variável: ele sobe sem autenticação e tem
# o seu próprio INSPECTOR_BIND_ADDR, mais abaixo.
BIND_ADDR=127.0.0.1

# Portas publicadas no host pelo docker-compose. A homepage é estática e só
# lê PORT/HOST: não conhece o catálogo, o banco nem os MCPs.
HOMEPAGE_PORT=3004
SITE_PORT=3000
ADMIN_PORT=3001
MCP_PUBLIC_PORT=3002
MCP_ADMIN_PORT=3003
POSTGRES_PORT=5432

# Endereço em que a porta do Postgres é publicada — só dela, e não o BIND_ADDR
# global. Nenhum app usa esta porta: todos falam com o banco por `postgres:5432`
# na rede interna do compose. Ela existe para o psql e o cliente gráfico de quem
# administra a máquina, e por isso fica no loopback mesmo com BIND_ADDR=0.0.0.0
# — publicar o banco na rede é expor um servidor sem limite de tentativa de
# login, sem trava de conta e com a senha que está neste arquivo.
POSTGRES_BIND_ADDR=127.0.0.1

# MCP Inspector — ferramenta de depuração, parte oficial da stack (sobe
# junto no `docker compose up -d`).
# INSPECTOR_ALLOWED_ORIGINS acompanha a INSPECTOR_PORT sozinha; só preencha se
# for abrir a UI por outra origem (um proxy em http://localhost:8080, por ex.).
# 6274 é a porta da própria imagem do inspector (é a que ela expõe e a que o
# healthcheck dela consulta), e o compose a mantém dos dois lados. Remapear só o
# lado do host é seguro: INSPECTOR_ALLOWED_ORIGINS acompanha esta variável.
INSPECTOR_PORT=6274
# Versão da imagem do inspector. Vazia usa o pin do compose, que é o valor
# revisado; `latest` aqui anula esse pin e traz a imagem que estiver no
# registro hoje.
INSPECTOR_TAG=
INSPECTOR_ALLOWED_ORIGINS=
# Onde o inspector guarda o token do mcp-admin digitado na UI (padrão:
# `memory`). Sem chaveiro do SO dentro do container, `memory` é o que existe —
# escolher explicitamente cala o aviso em vermelho no log.
INSPECTOR_SECRET_STORE=
# Endereço em que a porta do inspector é publicada — só dele, e não o BIND_ADDR
# global. A UI sobe sem autenticação e, de dentro da rede `internal`, alcança o
# mcp-admin: quem chega nesta porta opera o catálogo inteiro sem credencial.
# Por isso ela fica no loopback mesmo com BIND_ADDR=0.0.0.0.
INSPECTOR_BIND_ADDR=127.0.0.1
# Precisa mesmo da UI acessível de outra máquina? Mude as duas linhas abaixo
# junto com a de cima: INSPECTOR_OMIT_AUTH=false liga a autenticação do próprio
# inspector, que passa a exigir o token em toda chamada da sua API. Gere o token
# com `openssl rand -hex 32` — não deixe `CHANGE_ME` aqui.
# INSPECTOR_OMIT_AUTH=false
# INSPECTOR_API_TOKEN=

# FQDNs públicos usados pelo override do Traefik
# (docker compose -f docker-compose.yml -f docker-compose.traefik.yml up -d)
HOMEPAGE_FQDN=www.example.com
SITE_FQDN=site.example.com
ADMIN_FQDN=admin.example.com
MCP_PUBLIC_FQDN=mcp.example.com
MCP_ADMIN_FQDN=mcp-admin.example.com

# Força a flag Secure do cookie de sessão do painel.
# Vazio = automático (Secure só quando a requisição chega por HTTPS).
# Atrás de HTTPS em produção, deixe explicitamente como true.
ADMIN_COOKIE_SECURE=

# Em quais proxies confiar para X-Forwarded-Proto / X-Forwarded-For.
# Vazio (padrão): um salto, e só se quem abriu a conexão for loopback ou faixa
# privada — cobre Traefik numa rede Docker ou um nginx no host, e o IP do
# cliente passa a ser o que o proxy anotou, não o que o cliente disse.
# Com valor, é obedecido ao pé da letra: o endereço ou o CIDR do proxy
# (`172.18.0.2`, `10.1.0.0/16` — o mais seguro, porque não confia nos vizinhos
# dele), `2` para dois proxies em cadeia, `loopback, uniquelocal` para o padrão
# anterior (toda a RFC1918, em qualquer profundidade), ou `true` (confia em
# qualquer origem — não use em produção exposta).
# Dois proxies internos em sequência: declare o valor, senão o IP do cliente
# vira o do proxy de dentro.
TRUST_PROXY=

# Origens extras aceitas nas escritas do painel, além da própria (anti-CSRF).
# Normalmente vazio: o painel é sempre same-origin.
ADMIN_ALLOWED_ORIGINS=

# Limites de descompressão de .zip (defesa contra zip bomb).
ZIP_MAX_UNCOMPRESSED_BYTES=268435456
ZIP_MAX_ENTRIES=512

# Sessões dos servidores MCP mantidas em memória.
MCP_MAX_SESSIONS=500
MCP_SESSION_TTL_MS=1800000
# Teto de sessões simultâneas por credencial (o MCP virtual + a chave psv_, ou
# o token do admin), somando os dois transportes com sessão. Vazio = um décimo
# de MCP_MAX_SESSIONS, nunca menos de 10 — deixe vazio para que os dois subam
# juntos. Estourar não recusa a sessão nova: fecha a sessão parada há mais tempo
# da mesma credencial, e o cliente reabre.
MCP_MAX_SESSIONS_PER_IDENTITY=
# Intervalo da varredura que expira sessão parada, em ms (padrão: 60000).
MCP_SESSION_SWEEP_MS=
# Janela em que um cliente do MCP público conta como "online" no painel, em
# ms (padrão: 2 min). Vale para o contador do canvas e para agrupar as
# requisições stateless de um mesmo cliente numa sessão só
# (docs/10-admin-canvas-e-sessoes.md). A tabela de sessões nunca é podada.
MCP_SESSION_ONLINE_WINDOW_MS=120000

# Teto do corpo JSON aceito pelos servidores MCP, lido só depois da
# autenticação. Padrões: 1mb no público (argumentos são pequenos) e 48mb no
# admin (o set_files_bulk manda o .zip em base64).
MCP_JSON_LIMIT=
# Teto do zip em base64 do set_files_bulk, em caracteres (padrão: 32 MB)
MCP_MAX_ZIP_BASE64=33554432
# Requisições por minuto por IP no MCP público (padrão: 600; `0` desliga, para
# quem já limita no proxy). Alto porque o cliente é agente, que trabalha em
# rajada, e vários saem pelo mesmo IP; quem chega com chave psv_ não gasta a
# cota do endereço.
MCP_RATE_LIMIT_MAX=
# Identidades stateless contabilizadas ao mesmo tempo (padrão: 5000). Atingido o
# teto, a requisição é atendida sem virar linha em mcp_sessions — é o que impede
# um user-agent variável de encher uma tabela que nunca é podada.
MCP_MAX_STATELESS_SESSIONS=
# Teto do texto que get_skill_file devolve DENTRO do resultado da ferramenta,
# em bytes (padrão: 4 MiB). Acima dele a resposta passa a ser a URL de download,
# como já acontece com arquivo binário.
MCP_MAX_FILE_TEXT_BYTES=

# ---------------------------------------------------------------------------
# Contas, papéis e SSO — docs/05-accounts-and-roles.md
# ---------------------------------------------------------------------------

# Endereço público do painel. Base do `redirect_uri` do SSO e do link de
# redefinição de senha que sai por e-mail. Exemplo:
#   ADMIN_PUBLIC_URL=https://admin.example.com
# Vazio: o `redirect_uri` ainda é deduzido do Host da requisição (o provedor
# confere o endereço registrado), mas o link de redefinição só aceita o Host
# quando o pedido vem de rede interna — loopback ou faixa privada, o mesmo
# conjunto do TRUST_PROXY padrão. É o que mantém a instalação local funcionando
# sem configurar nada. Exposto na Internet e sem esta variável,
# POST /api/password-reset/request responde 503 e a redefinição passa a ser
# feita por um administrador: deduzir do Host deixaria quem pede o reset
# escolher o domínio do link que chega à caixa da vítima.
ADMIN_PUBLIC_URL=

# Rate limiting do login, em duas camadas.
# LOGIN_MAX_ATTEMPTS / LOGIN_LOCK_SECONDS travam a CONTA (sobrevive a restart);
# LOGIN_IP_* são a janela em memória por IP, que absorve a rajada sem tocar o
# banco. Nenhuma das duas resolve sozinha.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_SECONDS=900
LOGIN_IP_MAX_ATTEMPTS=30
LOGIN_IP_WINDOW_SECONDS=300

# --- Login por OIDC (opcional) ---------------------------------------------
# Vazio = desligado, e o botão nem aparece no painel. Os três primeiros são
# obrigatórios juntos. O fluxo é authorization code + PKCE com discovery
# automático; registre no provedor o redirect_uri:
#   <ADMIN_PUBLIC_URL>/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# Nome mostrado no botão "Entrar com …".
OIDC_PROVIDER_NAME=SSO
OIDC_SCOPES=openid email profile

# Domínios de e-mail autorizados, separados por vírgula (subdomínios entram).
# VAZIO DESLIGA O AUTO-PROVISIONAMENTO, de propósito: um `leitor` enxerga o
# catálogo inteiro, inclusive o que não está em servidor aberto nenhum, então
# uma instalação mal configurada o entregaria a qualquer conta do provedor. A allowlist vale também para autenticar e para
# vincular um login OIDC a uma conta local já existente.
OIDC_ALLOWED_DOMAINS=
# false exige convite prévio mesmo dentro dos domínios autorizados.
OIDC_AUTO_PROVISION=true

# --- Envio de e-mail (opcional) --------------------------------------------
# Sem SMTP o painel continua completo: o "esqueci a senha" passa a orientar a
# pedir a redefinição a um administrador, que gera uma senha temporária.
SMTP_URL=
# SMTP_URL_FILE=/run/secrets/smtp_url
SMTP_FROM=
# Validade do link de redefinição, em segundos (padrão: 1h).
PASSWORD_RESET_TTL=3600

# ---------------------------------------------------------------------------
# RAG / busca semântica
# ---------------------------------------------------------------------------
# A busca por significado, fundida com a full-text de sempre. Desligada por
# padrão: sem RAG_DRIVER o projeto se comporta exatamente como antes.
#
# Três drivers, um provedor cada. Quem escolhe entre eles é o painel, não este
# arquivo: RAG_DRIVER só semeia o valor no primeiro boot do admin. As CHAVES,
# essas sim, são deste arquivo — e dá para deixar mais de uma configurada: os
# containers montam todos os drivers que tiverem chave e passam a obedecer ao
# painel na hora, sem recriar container nenhum.
#
# | driver | modelos                                        | dimensões   |
# |--------|------------------------------------------------|-------------|
# | google | gemini-embedding-2                             | 3072        |
# | openai | text-embedding-3-small, text-embedding-3-large | 1536 / 3072 |
# | voyage | voyage-4-lite, voyage-4, voyage-4-large        | 1024        |
#
# Trocar de driver OU de modelo troca o espaço de embedding: o acervo é
# reindexado no espaço novo e os vetores do anterior ficam onde estão, prontos
# para quando alguém voltar atrás. Nada é apagado.
#
# AVISO — uso dos dados, e é SÓ DO GOOGLE. No nível gratuito da Gemini API o
# conteúdo enviado é usado para melhorar produtos, e revisores humanos podem
# lê-lo. Isso vale para o texto de TODA skill indexada, inclusive as privadas,
# e para cada consulta de busca. Para que não seja usado, gere a chave num
# projeto com faturamento ativo. No Espaço Econômico Europeu, na Suíça e no
# Reino Unido, só o nível pago é permitido para quem oferece o serviço a
# usuários dessas regiões. OpenAI e Voyage não treinam sobre o tráfego da API.

# `google`, `openai` ou `voyage` ligam a busca semântica; `off` ou vazio
# desliga. Lida só pelo admin, que a grava no banco no primeiro boot: dali em
# diante quem manda é o valor do painel, e mudar esta variável passa a ser
# apenas um aviso no log.
RAG_DRIVER=
# O modelo, validado contra os do driver escolhido. Vazio = o padrão do driver
# (gemini-embedding-2, text-embedding-3-small ou voyage-4-lite).
RAG_MODEL=

# As chaves. Vão para o indexer, o mcp-public e o site; NUNCA para o painel, e
# nunca na URL — só no header. Configure as do driver que pretende usar;
# deixar mais de uma é o que permite trocar de provedor só pelo painel.
RAG_GOOGLE_API_KEY=CHANGE_ME
# RAG_GOOGLE_API_KEY_FILE=/run/secrets/rag_google_api_key
RAG_OPENAI_API_KEY=CHANGE_ME
# RAG_OPENAI_API_KEY_FILE=/run/secrets/rag_openai_api_key
RAG_VOYAGE_API_KEY=CHANGE_ME
# RAG_VOYAGE_API_KEY_FILE=/run/secrets/rag_voyage_api_key

# URL base já COM a versão da API, uma por driver. Usada como está: a versão
# nunca é acrescentada pelo código. Nos testes, aponte para o servidor falso.
RAG_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
RAG_OPENAI_BASE_URL=https://api.openai.com/v1
RAG_VOYAGE_BASE_URL=https://api.voyageai.com/v1

# Espera máxima pelo embedding da consulta antes de cair na busca textual.
# Estourar o prazo não é erro: a resposta volta com `mode: "text"`.
RAG_QUERY_TIMEOUT_MS=2000

# Intervalo da varredura do indexador, em segundos.
RAG_INDEX_INTERVAL_SECONDS=30

# Prazo de cada lote enviado ao provedor durante a indexação (ms). Diferente do
# RAG_QUERY_TIMEOUT_MS: aqui estourar o prazo aborta o lote, que volta à fila no
# ciclo seguinte. Vazio usa o padrão do código (120000; faixa 1000–600000).
RAG_INDEX_TIMEOUT_MS=
