    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@purple-skills/shared": "*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.4"
  }
}
